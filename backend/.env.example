# Environment Configuration Example
# Copy this file to a new file named '.env' and modify the values for your environment.

PROJECT_NAME="Employee Task Tracker"
API_V1_STR="/api"
SECRET_KEY="YOUR_SUPER_SECRET_JWT_KEY_FOR_EMPLOYEE_TASK_TRACKER"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# To use SQLite locally:
# DATABASE_URL="sqlite:///./task_tracker.db"

# To use MySQL:
DATABASE_URL="mysql+pymysql://db_user:db_password@db_host:3306/employee_task_tracker"
